+// Windows 11 (24H2/25H2) Search databases declare collations that only exist
+// inside Windows Search (e.g. "UNICODE_en-US", "UNICODE_en-US_LINGUISTIC_IGNORECASE").
+// Plain SQLite cannot even prepare statements without them. Register a
+// case-insensitive stand-in for any collation SQLite asks for on this connection.
+extern "C" fn win_search_collate(
+    _ctx: *mut std::os::raw::c_void,
+    l1: std::os::raw::c_int,
+    p1: *const std::os::raw::c_void,
+    l2: std::os::raw::c_int,
+    p2: *const std::os::raw::c_void,
+) -> std::os::raw::c_int {
+    let a = unsafe { std::slice::from_raw_parts(p1 as *const u8, l1.max(0) as usize) };
+    let b = unsafe { std::slice::from_raw_parts(p2 as *const u8, l2.max(0) as usize) };
+    let a = String::from_utf8_lossy(a).to_lowercase();
+    let b = String::from_utf8_lossy(b).to_lowercase();
+    match a.cmp(&b) {
+        std::cmp::Ordering::Less => -1,
+        std::cmp::Ordering::Equal => 0,
+        std::cmp::Ordering::Greater => 1,
+    }
+}
